rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if user is accessing their own data
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Helper function to check if user is a counselor
    function isCounselor(counselorId) {
      return isAuthenticated() && request.auth.uid == counselorId;
    }

    // Helper function to check if user is an admin
    function isAdmin() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Allow users to read and write their own wellness data
    match /wellness/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.userId;
    }
    
    // Allow users to read and write their own profile data
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Users collection
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow write: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
    }

    // Posts collection
    match /posts/{postId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.authorId == request.auth.uid;
      allow update: if isAuthenticated() && (
        // Allow updates to comments array by any authenticated user
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['comments', 'replies', 'views']) ||
        // Allow updates by post owner
        isOwner(resource.data.authorId)
      );
      allow delete: if isOwner(resource.data.authorId);
    }

    // Comments collection
    match /comments/{commentId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isOwner(resource.data.userId);
    }

    // Community posts collection
    match /community/{postId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.authorId == request.auth.uid;
      allow update: if isAuthenticated() && (
        // Allow updates to comments array by any authenticated user
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['comments', 'replies', 'views', 'likes', 'updatedAt']) ||
        // Allow updates by post owner
        isOwner(resource.data.authorId)
      );
      allow delete: if isOwner(resource.data.authorId);
    }

    // Check-ins collection
    match /checkins/{checkinId} {
      allow read: if isOwner(resource.data.userId);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isOwner(resource.data.userId);
    }

    // Wellness checks collection
    match /wellnessChecks/{checkId} {
      allow read: if isAuthenticated() && (
        // Allow reading if the userId matches the authenticated user
        request.auth.uid == resource.data.userId ||
        // Allow reading if the query is filtered by userId matching the authenticated user
        (request.query.filters.size() > 0 && 
         request.query.filters[0].op == '==' && 
         request.query.filters[0].path == ['userId'] && 
         request.query.filters[0].value == request.auth.uid)
      );
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isOwner(resource.data.userId);
    }

    // Wellness collection
    match /wellness/{entryId} {
      allow read: if isAuthenticated() && (
        // Allow reading if the userId matches the authenticated user
        request.auth.uid == resource.data.userId ||
        // Allow reading if the query is filtered by userId matching the authenticated user
        (request.query.filters.size() > 0 && 
         request.query.filters[0].op == '==' && 
         request.query.filters[0].path == ['userId'] && 
         request.query.filters[0].value == request.auth.uid)
      );
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isOwner(resource.data.userId);
    }

    // Badges collection
    match /badges/{badgeId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // User badges collection
    match /userBadges/{userBadgeId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
    }

    // Available badges collection
    match /availableBadges/{badgeId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Focus areas collection
    match /focus_areas/{areaId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Appointments collection
    match /appointments/{appointmentId} {
      allow read: if isOwner(resource.data.userId);
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isOwner(resource.data.userId);
    }

    // Bookings collection
    match /bookings/{bookingId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || 
        resource.data.therapistId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || 
        resource.data.therapistId == request.auth.uid ||
        isAdmin()
      );
    }

    // Allow listing all bookings for admin users
    match /bookings/{document=**} {
      allow list: if isAdmin();
    }

    // Counselors collection rules
    match /counselors/{counselorId} {
      allow read: if true;  // Anyone can read counselor profiles
      allow write: if isAuthenticated() && request.auth.uid == counselorId;
    }

    // Study Sessions collection
    match /studySessions/{sessionId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        (request.query.filters.size() > 0 && 
         request.query.filters[0].op == '==' && 
         request.query.filters[0].path == ['userId'] && 
         request.query.filters[0].value == request.auth.uid)
      );
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isOwner(resource.data.userId);
    }

    // Stress Techniques collection
    match /stressTechniques/{techniqueId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Exam Resources collection
    match /examResources/{resourceId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Notifications collection
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        (request.query.filters.size() > 0 && 
         request.query.filters[0].op == '==' && 
         request.query.filters[0].path == ['userId'] && 
         request.query.filters[0].value == request.auth.uid)
      );
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isOwner(resource.data.userId);
    }

    // Journal entries collection
    match /journalEntries/{entryId} {
      allow read: if isAuthenticated() && (
        // Allow reading if the userId matches the authenticated user
        request.auth.uid == resource.data.userId ||
        // Allow reading if the query is filtered by userId matching the authenticated user
        (request.query.filters.size() > 0 && 
         request.query.filters[0].op == '==' && 
         request.query.filters[0].path == ['userId'] && 
         request.query.filters[0].value == request.auth.uid)
      );
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isOwner(resource.data.userId);
    }

    // Feedback collection
    match /feedback/{feedbackId} {
      allow read: if isAuthenticated() && (
        // Allow reading if the userId matches the authenticated user
        request.auth.uid == resource.data.userId ||
        // Allow reading if the query is filtered by userId matching the authenticated user
        (request.query.filters.size() > 0 && 
         request.query.filters[0].op == '==' && 
         request.query.filters[0].path == ['userId'] && 
         request.query.filters[0].value == request.auth.uid) ||
        // Allow admins to read all feedback
        isAdmin()
      );
      allow create: if isAuthenticated() && (
        // Allow anonymous feedback (no userId)
        !('userId' in request.resource.data) ||
        // Allow feedback with matching userId
        request.resource.data.userId == request.auth.uid
      );
      allow update, delete: if isAdmin();
    }

    // Surveys collection
    match /surveys/{surveyId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Survey responses collection
    match /surveyResponses/{responseId} {
      allow read: if isAuthenticated() && (
        // Allow reading if the userId matches the authenticated user
        request.auth.uid == resource.data.userId ||
        // Allow reading if the query is filtered by userId matching the authenticated user
        (request.query.filters.size() > 0 && 
         request.query.filters[0].op == '==' && 
         request.query.filters[0].path == ['userId'] && 
         request.query.filters[0].value == request.auth.uid) ||
        // Allow admins to read all responses
        isAdmin()
      );
      allow create: if isAuthenticated() && (
        // Allow anonymous responses (no userId)
        !('userId' in request.resource.data) ||
        // Allow responses with matching userId
        request.resource.data.userId == request.auth.uid
      );
      allow update, delete: if isAdmin();
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
} 